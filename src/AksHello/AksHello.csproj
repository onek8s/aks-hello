<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The release version, and the image tag: onek8s/aks-terraform builds the image of a commit
         into the environment's registry under it, and onek8s/aks-fluxcd-example then rolls it out by
         naming the tag. -->
    <Version>0.2.0</Version>
  </PropertyGroup>

</Project>
